PORT=3124
# Dominios del front separados por coma
CORS_ORIGIN=http://localhost:3000

# https://my.telegram.org → API development tools
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Generar con: npm run telegram:login --workspace=api
TELEGRAM_SESSION=

# JSON array de usernames (sin @ ni URL)
TELEGRAM_SOURCE=["RiC_Red_de_intercambio_CUBA","usdthabanaventaycompra","USD_Holguin","Cuba_Compra_Venta"]

# Ventana de mensajes a considerar (días)
TELEGRAM_DAYS=3

# OpenWA (WhatsApp). Usa el ID real de sesión y API key de tu OpenWA.
# OPENWA_API_URL puede ser http://openwa:2785/api si ambos servicios comparten red Docker.
OPENWA_API_URL=
OPENWA_API_KEY=
OPENWA_SESSION_ID=
# Nombres exactos de grupos o JID (@g.us); JSON array o lista separada por comas.
OPENWA_SOURCE=[]
OPENWA_DAYS=3

# Opcional: https://console.groq.com → API key free (sin tarjeta)
# Analiza los msgs del grupo cuando el regex no basta (emoji, posts multilínea)
GROQ_API_KEY=
# GROQ_MODEL=qwen/qwen3.8-27b
